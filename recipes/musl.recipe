# Category: Base System
# Last Update: 14-September-2026
# Maintainer: littlefly365

pkgname=musl
pkgver=1.2.6
pkgrel=0
pkgdesc="A lightweight implementation of the C standard library for Linux"
arch=all
url=https://musl.libc.org
source=$url/releases/$pkgname-$pkgver.tar.gz
license=MIT

build_style=gnu_configure
configure_args="--prefix=$PREFIX --syslibdir=$SYSLIBDIR --disable-static --disable-gcc-wrapper"

post_install_step()
{
	ln -sfv libc.so $LIBDIR/libm.so
	ln -sfv libc.so $LIBDIR/libpthread.so

	ln -sfv $LIBDIR/libc.so $BINDIR/ldd
	ln -sfv true $BINDIR/ldconfig
}
