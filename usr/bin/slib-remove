progname="$(basename $0)"

main()
{
	flags="-f"
	while [ $# -gt 0 ]; do
		case "$1" in
			--version)
				printf "$progname (AtlanticOS Tools) v1.0.0\n"
				exit 0
			;;
			--help)
				printf "%s\n%s\n%s\n%s\n%s\n"	\
					"Usage: $progname [OPTION] <LIBDIR>"	\
					"Options:"	\
					"  -v, --verbose        Print a message for each removed file"
					"      --help           Display this help and exit"	\
					"      --version        Output version information and exit"
				exit 0
			;;
			-v|--verbose)
				flags="-fv"
				shift
				;;
			-*)
				printf >&2 "%s\n%s\n"	\
					"$progname: invalid option '$1'"	\
					"Try '$progname --help' for more information."
				exit 1
			;;
			*)
				break
			;;
		esac
	done

	case "$#" in
		0)
			printf >&2 "%s\n%s\n"	\
				"$progname: missing operand"	\
				"Try '$progname --help' for more information."
			exit 1
		;;
		1)
			break;
		;;
		*)
			printf >&2 "%s\n%s\n"	\
				"$progname: extra operand '$2'"	\
				"Try '$progname --help' for more information."
			exit 1
		;;
	esac
		
	cd "$1" || exit 1

	for i in $1/*.a; do \
		rm $flags $i;
	done
}

main $@
