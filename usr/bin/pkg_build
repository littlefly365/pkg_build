progname="$(basename $0)"
OLDOLDPWD="$PWD"

# System paths
: "${HOST_PREFIX=/usr}"
: "${HOST_BINDIR=$HOST_PREFIX/bin}"
: "${SRCDIR=$HOST_PREFIX/src}"
: "${RECIPEDIR=$HOST_PREFIX/recipes}"

# Paths used in recipes
: "${DESTDIR=$OLDOLDPWD/dest}"
: "${PREFIX=/usr}"
: "${BINDIR=$PREFIX/bin}"
: "${SBINDIR=$PREFIX/sbin}"
: "${LIBDIR=$PREFIX/lib}"
: "${SYSLIBDIR=/lib}"
: "${INCLUDEDIR=$PREFIX/include}"
: "${SYSCONFDIR=/etc}"
: "${LIBEXECDIR=$PREFIX/libexec}"

# The variables below are path from binaries that can differ from systems
WGET="$HOST_BINDIR/wget"	# This can be replaced to use fetch, curl or other tool to download the source files
GMAKE="$HOST_BINDIR/make"

def_gnu_config="--prefix=$PREFIX --bindir=$BINDIR --sbindir=$SBINDIR --libdir=$LIBDIR --libexecdir=$LIBEXECDIR	\
		--sysconfdir=$SYSCONFDIR --includedir=$INCLUDEDIR"

prepare_step()
{
	:
}

pre_install_step()
{
	:
}

post_install_step()
{
	:
}

ldconfig()
{
	:
}

download_step()
{
	mkdir -p $SRCDIR && cd $SRCDIR
	$WGET $source || exit 1
	tar xf $(basename $source)

	cd $pkgname-$pkgver
}

configure_step()
{
	if [ -n "$extra_args" ]; then
		args="$def_gnu_config $extra_args"
	elif [ -n "$configure_args" ]; then
		args="$configure_args"
	fi

	case "$build_style" in
		gnu_configure|configure)
			if [ -x ./configure ]; then
				./configure $args
			elif [ -x ../configure ]; then
				../configure $args
			else
				printf >&2 "$progname: The configure script does not exist."
				exit 1
			fi
		;;
		*)
			break
		;;
	esac

}

build_step()
{
	case "$build_style" in
		gnu_configure|configue)
			"$GMAKE" -j"$(nproc)"
		;;
		*)
			break
		;;
	esac
}

install_step()
{
	case "$build_style" in
		gnu_configure|configure)
			$GMAKE DESTDIR="$DESTDIR" install || exit 1
		;;
		*)
			break
		;;
	esac
}

check_recipe()
{
	if [ ! -f "$RECIPEDIR/$1.recipe" ]; then
		printf >&2 "$progname: The package '$1' does not have a recipe.\n"
		exit 1
	else
		. "$RECIPEDIR/$1.recipe"
	fi

	if [ -z "$pkgname" ] || [ -z "$pkgver" ] || [ -z "$pkgrel" ] || [ -z "$source" ] || [ -z "$build_style" ]; then
		printf >&2 "$progname: The recipe for the package '$1' does not have the enough information.\n"
		exit 1
	fi
}

clean_step()
{
	rm -rf $SRCDIR
}

main()
{
	while [ $# -gt 0 ]; do
		case "$1" in
			-V|--version)
				printf "$progname (AtlanticOS Tools) v1.0.0\n"
				exit 0
			;;
			-h|--help)
				printf "%s\n%s\n%s\n%s\n"	\
					"Usage: $progname [OPTION] <pkgname>"	\
					"Options:"	\
					"  -h, --help           Display this help and exit"	\
					"  -V, --version        Output version information and exit"
				exit 0
			;;
			-*)
				printf >&2 "%s\n%s\n"	\
					"$progname: invalid option '$1'"	\
					"Try '$progname --help' for more information."
				exit 1
			;;
			*)
				break
			;;
		esac
	done

	case "$#" in
		0)
			printf >&2 "%s\n%s\n"	\
				"$progname: missing operand"	\
				"Try '$progname --help' for more information."
			exit 1
		;;
		1)
			break;
		;;
		*)
			printf >&2 "%s\n%s\n"	\
				"$progname: extra operand '$2'"	\
				"Try '$progname --help' for more information."
			exit 1
		;;
	esac

	check_recipe "$1"

	download_step
	prepare_step
	configure_step
	build_step
	pre_install_step
	install_step
	post_install_step

	find "$DESTDIR" -mindepth 1 -name ".*" -prune -o -print | sed "s|^$DESTDIR/|/|" > "$OLDOLDPWD/manifest"

	clean_step
}

main $@
